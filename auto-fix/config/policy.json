{
  "schemaVersion": 1,
  "mode": "observe-only",
  "runtimeEnabled": false,
  "authorities": {
    "readSource": false,
    "writeSource": false,
    "executeCommands": false,
    "createBranch": false,
    "commit": false,
    "build": false,
    "sign": false,
    "release": false,
    "rollout": false,
    "rollback": false
  },
  "limits": {
    "maxRepairIterations": 5,
    "maxPatchFiles": 0,
    "maxPatchLines": 0,
    "maxJobTokenBudget": 0,
    "maxJobDurationSeconds": 0,
    "maxAuditRecordBytes": 16384,
    "maxEvidenceItems": 32,
    "maxEvidenceStringLength": 1024
  },
  "boundaries": {
    "approvedRelativeRoots": ["auto-fix"],
    "deniedRelativeRoots": ["resources", "build-output", "node_modules"],
    "denySensitiveNames": true
  },
  "audit": {
    "appendOnly": true,
    "redactSecrets": true
  },
  "gates": {
    "requireReproduction": true,
    "requireRegression": true,
    "requireBuildVerification": true,
    "requireSecurityScan": true,
    "requireArtifactVerification": true,
    "highRiskRequiresHumanApproval": true
  },
  "highRiskAreas": [
    "authentication",
    "authorization",
    "encryption",
    "signing",
    "updater",
    "licensing",
    "security",
    "database",
    "native-process-boundary",
    "cookie-token-session"
  ],
  "notes": [
    "Observe-only policy for Milestone 1 readiness; validation exists but runtime is not connected.",
    "Never place secrets, tokens, cookies, private keys or credentials in this file.",
    "Authority changes require a completed milestone and an audit/review record."
  ]
}
