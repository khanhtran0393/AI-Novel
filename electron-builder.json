{
  "appId": "com.novastudio.independent",
  "productName": "Nova Studio",
  "artifactName": "Nova-Studio-${version}-${arch}.${ext}",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "package.json",
    "nova/**/*",
    "!nova/**/*.map",
    "!nova/node_modules{,/**/*}",
    "!nova/upscaler-bin{,/**/*}",
    "!nova/inpaint-bin{,/**/*}",
    "!nova/voice-backend{,/**/*}",
    "!nova/sqlite-bin{,/**/*}",
    "!nova/onnx-bin{,/**/*}",
    "!nova/ytdlp-bin{,/**/*}",
    "!nova/editor-pro/remotion-browser{,/**/*}"
  ],
  "asar": true,
  "asarUnpack": [
    "nova/**/*.py",
    "node_modules/ffmpeg-static/**/*",
    "node_modules/ffprobe-static/**/*",
    "node_modules/onnxruntime-node/**/*"
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Nova Studio",
    "uninstallDisplayName": "Nova Studio"
  },
  "publish": null
}
