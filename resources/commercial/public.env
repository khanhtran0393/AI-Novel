# Public defaults bundled with the commercial desktop app.
# This file must contain public endpoints and feature switches only.
# No private keys / admin / service_role.
AINOVEL_ENTITLEMENT_MODE=enforce
AINOVEL_LICENSE_API_URL=https://ai-novel-flax.vercel.app
# Extra hosts allowed for license API (comma). Builtin always includes ai-novel-flax.vercel.app
# AINOVEL_LICENSE_API_HOSTS=
# Optional TLS SPKI pins (sha256/BASE64). Empty = WebPKI only + host pin.
# Generate: node scripts/print-license-tls-pin.mjs
# AINOVEL_LICENSE_TLS_PINS=
AINOVEL_TRIAL_ENABLED=1
AINOVEL_TRIAL_DAYS=3
AINOVEL_ALLOW_LOCAL_TRIAL=0
AINOVEL_UPDATE_CHANNEL=stable
# github = public release-only repo (code stays private). generic = Supabase/CDN feed.
AINOVEL_UPDATE_PROVIDER=github
AINOVEL_UPDATE_GITHUB_OWNER=khanhtran0393
AINOVEL_UPDATE_GITHUB_REPO=AI-Novel-release-
# Optional legacy generic feed (unused when PROVIDER=github)
# AINOVEL_UPDATE_FEED_URL=https://azlizrbjkqcyqnsmuccv.supabase.co/storage/v1/object/public/desktop-updates/latest
# AINOVEL_UPDATE_FEED_HOSTS=
AINOVEL_UPDATE_CHECK_ON_LAUNCH=1
AINOVEL_UPDATE_ALLOW_PRERELEASE=0
# 1 = accept unsigned update packages (default: unsigned installs allowed).
# Set 0 only when every release is Authenticode-signed.
AINOVEL_UPDATE_ALLOW_UNSIGNED=1
