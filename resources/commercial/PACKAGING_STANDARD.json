{
  "schema": 3,
  "id": "ainovel-packaging-standard",
  "title": "Ai Novel — Packaging standard",
  "version": "1.0.2",
  "updated": "2026-07-22",
  "brand": {
    "appName": "Ai Novel",
    "productName": "Ai Novel",
    "shortcutName": "Ai Novel",
    "windowTitle": "Ai Novel",
    "logoSource": "build/icon-source-logo.jpg",
    "splashLogo": "electron/splash-logo.jpg",
    "icons": {
      "ico": "build/icon.ico",
      "png": "build/icon.png"
    },
    "splash": {
      "showLogo": true,
      "forbidSpinnerRing": true,
      "transparentWindow": true,
      "floatingLogoOnly": true,
      "forbidSolidBackdrop": true,
      "minDisplayMs": 5000,
      "envOverride": "AINOVEL_SPLASH_MS",
      "module": "electron/splashBrand.js",
      "logoFile": "electron/splash-logo.jpg",
      "htmlFallback": "electron/splash.html",
      "docs": "docs/BRAND_SPLASH.md",
      "caption": "Ai Novel"
    },
    "packCommands": {
      "icons": "npm run brand:icons",
      "sync": "npm run brand:sync",
      "smoke": "npm run smoke:brand-splash",
      "requiredBeforeBuilder": ["brand:icons", "brand:sync"]
    },
    "taskbarIcon": "same_as_logo"
  },
  "signing": {
    "requiredForInstall": false,
    "unsignedInstallAllowed": true,
    "authenticodePreferred": true
  },
  "update": {
    "provider": "github",
    "owner": "khanhtran0393",
    "repo": "AI-Novel-release-",
    "policy": "download_then_install_next_launch",
    "allowUnsigned": true,
    "forbidGhTokenInPackage": true
  },
  "security": {
    "entitlementModePackaged": "enforce",
    "allowLocalTrial": false,
    "forbidOwnerUnlimited": true,
    "forbidModeOpen": true,
    "forbidPrivateKeysInPackage": true,
    "credentialStorage": "electron_safeStorage_dpapi",
    "shellReHardenOnPack": true,
    "electronFuses": true,
    "crownIpSeal": true,
    "productionBrowserSourceMaps": false,
    "auditPackageRequired": true,
    "licenseSoleTruth": "supabase_licenses_hwid",
    "deleteLedgerRowMeansFree": true,
    "heartbeatGraceSecDefault": 86400,
    "heartbeatFirstRunSecDefault": 21600,
    "strictOnlineGraceSecDefault": 10800,
    "seatPresenceWindowSecDefault": 600,
    "asarIntegrityDefault": true,
    "asarIntegrityFuseAfterRcedit": true,
    "packNotesDoc": "docs/PACK_NOTES.md"
  },
  "antiCrack": {
    "required": true,
    "docs": [
      "docs/PACK_NOTES.md",
      "docs/DEFENSE_LAYERS.md",
      "docs/LABYRINTH.md",
      "docs/LICENSE_ONE_PATH.md"
    ],
    "layers": [
      "feature_matrix_L0",
      "ed25519_L1",
      "api_hard_gate_L2",
      "packaged_enforce_L3",
      "electron_sandbox_L4",
      "hwid_L5",
      "heartbeat_L6",
      "audit_L7",
      "re_friction_L8",
      "labyrinth_mirage_wrongpath_L9"
    ],
    "smokes": [
      "npm run smoke:anti-tamper",
      "npm run smoke:labyrinth",
      "npm run smoke:re-harden",
      "npm run smoke:crown-ip",
      "npm run smoke:defense-pack",
      "npm run postpack:checklist -- dist-qa-unsigned"
    ],
    "noUncrackablePromise": true
  },
  "forbidden": [
    "splash_spinner_ring_instead_of_logo",
    "splash_solid_black_backdrop_instead_of_floating_logo",
    "splash_skip_under_5s_on_ship_build",
    "pack_without_brand_icons_sync",
    "taskbar_icon_not_brand_logo",
    "productName_not_Ai_Novel",
    "private_key_in_package",
    "service_role_in_package",
    "admin_key_in_package",
    "GH_TOKEN_in_package",
    "owner_unlimited_in_package",
    "entitlement_mode_open_in_package",
    "strip_labyrinth_or_antitamper_on_pack",
    "treat_local_token_crypto_as_pro_without_supabase_row",
    "pack_commercial_without_authenticode_when_claiming_signed",
    "confuse_pack_ship_portable_with_signed_retail"
  ],
  "commands": {
    "brandIcons": "npm run brand:icons",
    "preflight": "npm run preflight:pack",
    "packShip": "npm run pack:ship",
    "packCommercial": "npm run pack:commercial",
    "packNotes": "docs/PACK_NOTES.md",
    "postpackChecklist": "npm run postpack:checklist -- dist-qa-unsigned",
    "audit": "npm run audit:package -- dist-qa-unsigned/win-unpacked",
    "publishGithub": "npm run release:github"
  }
}
