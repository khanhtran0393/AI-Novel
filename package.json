{
  "name": "ai-novel-script-generator",
  "version": "1.0.0",
  "description": "AI Novel & Script Generator desktop app with independent CapAssistant engine",
  "author": "AI Novel",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:desktop": "electron .",
    "build:desktop": "next build && electron-builder --win nsis",
    "pack:portable": "next build && electron-builder --win portable",
    "test:capassistant": "npx tsx scratch/test-capassistant-independent.mjs",
    "test:auto-master": "npx tsx scratch/test-auto-master.mjs",
    "test:self-heal": "npx tsx scratch/test-self-heal-brain.mjs",
    "test:persist": "node scratch/test-durable-persist.mjs"
  },
  "build": {
    "appId": "com.ainovel.desktop",
    "productName": "AI Novel & Script Generator",
    "copyright": "Copyright © AI Novel",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "AI-Novel-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AI Novel"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "electron/**/*",
      "package.json",
      "next.config.ts",
      "next.config.js",
      "public/**/*",
      ".next/**/*",
      "node_modules/**/*",
      "src/**/*",
      "bin/**/*",
      "fonts/**/*",
      "python_core/**/*",
      "output/**/*",
      "!python_core/**/__pycache__/**",
      "!python_core/**/*.pyc",
      "!scratch/**/*",
      "!.git/**/*",
      "!dist/**/*",
      "!OpenMontage/**/*"
    ],
    "extraResources": [
      { "from": "bin", "to": "bin", "filter": ["**/*"] },
      { "from": "fonts", "to": "fonts", "filter": ["**/*"] }
    ]
  },
  "dependencies": {
    "@gradio/client": "^2.3.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "cutsdk": "^1.1.8",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^1.16.0",
    "music-metadata": "^7.13.0",
    "next": "16.2.6",
    "node-edge-tts": "^1.2.10",
    "puppeteer": "^25.0.4",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tiktok-tts": "^1.1.17",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
