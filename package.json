{
  "name": "ai-video-studio",
  "version": "0.1.34",
  "description": "AI Video Studio desktop application",
  "private": true,
  "main": "nova/main.plain.js",
  "author": "AI Video Studio",
  "productName": "AI Video Studio",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check:syntax": "node nova/scripts/syntax-check.js",
    "check:ipc": "node nova/scripts/ipc-inventory.js",
    "check:parity": "node nova/scripts/parity-check.js",
    "test:foundation": "node nova/scripts/foundation-test.js",
    "build:win": "electron-builder --config electron-builder.json --win",
    "build": "electron-builder --config electron-builder.json",
    "smoke:packaged": "node nova/scripts/packaged-smoke.js",
    "build:smoke": "npm run build:win && npm run smoke:packaged"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "onnxruntime-node": "^1.27.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^3.0.2"
  }
}
