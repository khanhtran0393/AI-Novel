{
  "name": "ai-novel-script-generator",
  "version": "1.0.0",
  "description": "AI Novel & Script Generator desktop app with independent CapAssistant engine",
  "author": "AI Novel",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke:core": "node scripts/smoke-core.mjs",
    "audit:functional": "npx tsx scripts/audit-functional-full.mjs",
    "test:e2e": "playwright test",
    "verify:ci": "npm run typecheck && npm run smoke:core && npm run test:e2e",
    "dev:desktop": "electron .",
    "build:desktop": "next build && electron-builder --win nsis",
    "pack:portable": "next build && electron-builder --win portable",
    "test:capassistant": "npx tsx scratch/test-capassistant-independent.mjs",
    "test:auto-master": "npx tsx scratch/test-auto-master.mjs",
    "test:self-heal": "npx tsx scratch/test-self-heal-brain.mjs",
    "test:persist": "node scratch/test-durable-persist.mjs",
    "test:channel-ship": "npx tsx src/scripts/verify-channel-ship.mjs",
    "test:channel-dna": "npx tsx src/scripts/verify-channel-output-dna.mjs",
    "test:integrations": "node scripts/test-integrations-hub.mjs",
    "test:chapter-pipeline": "npx tsx scripts/test-chapter-pipeline.mjs",
    "test:chapter-tts": "npx tsx scripts/test-chapter-tts-selfcheck.mjs",
    "test:youtube-psych": "npx tsx scripts/test-youtube-psych55.mjs",
    "audit:workspace-script": "npx tsx scripts/audit-workspace-script-quality.mjs",
    "audit:output-criteria": "npx tsx scripts/audit-output-criteria.mjs",
    "rebuild:ship-packs": "npx tsx scripts/rebuild-all-ship-packs.mjs",
    "smoke:regen": "node scripts/smoke-regen-if-server.mjs",
    "test:youtube-safe": "npx tsx scripts/verify-youtube-safe.mjs",
    "verify:core": "npx tsx src/scripts/verify-channel-output-dna.mjs && npx tsx src/scripts/verify-channel-ship.mjs && npx tsx src/scripts/verify-publish-readiness.mjs && npx tsx scripts/verify-youtube-safe.mjs && npx tsx scripts/audit-output-criteria.mjs",
    "verify:all": "npm run verify:core && npm run rebuild:ship-packs && npm run test:e2e && npm run smoke:regen",
    "test:e2e:ui": "playwright test --project=ui",
    "test:e2e:api": "playwright test --project=api-and-contracts"
  },
  "build": {
    "appId": "com.ainovel.desktop",
    "productName": "AI Novel & Script Generator",
    "copyright": "Copyright © AI Novel",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AI-Novel-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AI Novel"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "electron/**/*",
      "package.json",
      "next.config.ts",
      "next.config.js",
      "public/**/*",
      ".next/**/*",
      "node_modules/**/*",
      "src/**/*",
      "bin/**/*",
      "fonts/**/*",
      "python_core/**/*",
      "output/**/*",
      "!python_core/**/__pycache__/**",
      "!python_core/**/*.pyc",
      "!scratch/**/*",
      "!.git/**/*",
      "!dist/**/*",
      "!OpenMontage/**/*",
      "!Voice Studio/**/*",
      "!ainovel-cli-main/**/*",
      "!exports/**/*",
      "!test-results/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "fonts",
        "to": "fonts",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@gradio/client": "^2.3.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "cutsdk": "^1.1.8",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^1.16.0",
    "music-metadata": "^7.13.0",
    "next": "16.2.6",
    "node-edge-tts": "^1.2.10",
    "puppeteer": "^25.0.4",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tiktok-tts": "^1.1.17",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
