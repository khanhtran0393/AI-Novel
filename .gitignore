# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large binaries and assets
/bin/
/python_core/
*.exe
*.onnx
*.mp3
*.mp4
*.wav

# === LOCKED Vina ONNX brain (permanent core asset ~1.46GB) ===
# Must stay under src/python_core/models/vina_voice/ for clone native.
!src/python_core/models/vina_voice/
!src/python_core/models/vina_voice/vocab.txt
!src/python_core/models/vina_voice/MANIFEST.json
!src/python_core/models/vina_voice/README.md
# ONNX weights: keep on disk; track via LFS if desired (uncomment next 3 lines):
# !src/python_core/models/vina_voice/model-tts_0.onnx
# !src/python_core/models/vina_voice/model-tts_1.onnx
# !src/python_core/models/vina_voice/model-tts_2.onnx

